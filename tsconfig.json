{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": []
  },
  "include": [
    "types/**/*.d.ts",
    "analysis/**/*.mjs",
    "analysis/**/*.js",
    "reports/**/*.mjs",
    "src/**/*.mjs",
    "src/**/*.js",
    "studies/**/*.js",
    "utils/**/*.js",
    "*.mjs",
    "*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "docs",
    "output",
    "tests",
    "playwright-tests",
    "**/*.test.*"
  ]
}
