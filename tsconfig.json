{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": [
    "types/**/*.d.ts",
    "analysis/scheduleWorkflow.mjs",
    "analysis/trayFill.mjs",
    "analysis/studyResultContext.mjs",
    "analysis/studyExportMetadata.mjs",
    "analysis/arcFlashResultUnits.mjs",
    "analysis/cableOperatingVoltage.mjs",
    "analysis/routeResults.mjs",
    "src/components/resultViz.mjs",
    "studies/shortCircuitExportTable.mjs"
  ]
}
