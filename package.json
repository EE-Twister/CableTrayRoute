{
  "name": "cabletrayroute",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/validateProtectiveDevices.mjs && node scripts/buildProtectiveDeviceCatalog.mjs && node scripts/buildFastJsonPatch.cjs && rollup -c rollup.config.cjs && node scripts/checkBundleBudgets.mjs && node scripts/copyAssets.cjs && node scripts/rewriteHtmlForManifest.cjs && node scripts/generateValidationManifest.cjs && node scripts/auditHtmlAssetReferences.mjs --fix",
    "sample:engineering-report": "npm run build && node scripts/captureEngineeringReportVisuals.mjs && python scripts/generateEngineeringSamplePackage.py",
    "sample:engineering-report:setup": "python -m pip install -r scripts/engineering-report-requirements.txt",
    "build:cloudflare": "node scripts/generateSupabaseConfig.mjs && npm run build",
    "build:manifest": "node scripts/generateValidationManifest.cjs",
    "test": "npm run test:full",
    "e2e": "npm run e2e:full",
    "server": "npm run build && node server.mjs",
    "server:fast": "node server.mjs",
    "lint": "eslint . --max-warnings=0 --ignore-pattern \"dist/**\" --ignore-pattern \"node_modules/**\" && npm run lint:architecture && npm run lint:css",
    "lint:architecture": "node scripts/checkArchitectureBoundaries.mjs && node scripts/checkModuleCycles.mjs",
    "lint:css": "node scripts/checkCssArchitecture.mjs",
    "test:critical": "node tests/ampacity.test.mjs && node tests/racewayRoute.test.cjs && node tests/analysis.test.cjs && node tests/serverSecurity.test.mjs && node tests/collaborationServer.test.mjs && node tests/projectDisplayScheduler.test.mjs && node tests/revitImporter.test.mjs && node tests/validation.test.mjs && node tests/validationManifest.test.mjs && node tests/studyBasis.test.mjs",
    "test:full": "node scripts/runNodeTests.mjs",
    "test:enterprise-auth": "node tests/auditLog.test.mjs && node tests/rbac.test.mjs && node tests/oidc.test.mjs",
    "e2e:critical": "playwright test --config playwright.config.cjs playwright-tests/workflow.spec.js playwright-tests/cableschedule.spec.js playwright-tests/oneline.spec.js playwright-tests/nextFeatures.smoke.spec.js --grep \"create DB-01|design basis gates|dirty-state prompts|load sample cables populates table|editing a source voltage|smoke:\"",
    "e2e:full": "playwright test --config playwright.config.cjs",
    "visual:regression": "playwright test --config playwright.visual.config.cjs",
    "visual:regression:update": "playwright test --config playwright.visual.config.cjs --update-snapshots",
    "perf:browser": "node scripts/perf-browser-baseline.mjs",
    "perf:browser:report": "node scripts/perf-browser-baseline.mjs --no-enforce",
    "perf:summary": "node scripts/writePerformanceSummary.mjs",
    "e2e:next-features-integration": "playwright test --config playwright.config.cjs playwright-tests/nextFeatures.integration.spec.js",
    "e2e:next-features-cost": "playwright test --config playwright.config.cjs playwright-tests/nextFeatures.integration.spec.js --grep \"AT-CE-0[1-4]\"",
    "e2e:next-features-emf": "playwright test --config playwright.config.cjs playwright-tests/nextFeatures.integration.spec.js --grep \"AT-EMF-0[1-4]\"",
    "e2e:next-features-export": "playwright test --config playwright.config.cjs playwright-tests/nextFeatures.integration.spec.js --grep \"AT-CE-04|submittal xlsx export downloads expected file\"",
    "e2e:heat-trace": "playwright test --config playwright.config.cjs playwright-tests/heatTrace.acceptance.spec.js",
    "e2e:heat-trace-dashboard": "playwright test --config playwright.config.cjs playwright-tests/heatTrace.acceptance.spec.js --grep \"AT-HT-0[1-5]\"",
    "e2e:heat-trace-export": "playwright test --config playwright.config.cjs playwright-tests/heatTrace.acceptance.spec.js --grep \"AT-HT-06\"",
    "audit:catalog": "node scripts/auditManufacturerCatalog.mjs --check",
    "validate:protective-devices": "node scripts/validateProtectiveDevices.mjs",
    "build:protective-device-catalog": "node scripts/buildProtectiveDeviceCatalog.mjs",
    "promote:protective-devices": "node scripts/promoteProtectiveDeviceCandidates.mjs",
    "audit:components": "node scripts/componentCoverageAudit.mjs",
    "audit:symbol-continuity": "node scripts/auditOneLineSymbolContinuity.mjs",
    "audit:page-contracts": "node scripts/auditPageContracts.mjs",
    "check:html-assets": "node scripts/auditHtmlAssetReferences.mjs",
    "check:bundle-budgets": "node scripts/checkBundleBudgets.mjs",
    "check:cycles": "node scripts/checkModuleCycles.mjs",
    "check:dist-review": "node scripts/checkDistReviewNoise.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.5",
    "@playwright/test": "^1.41.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "ajv": "^6.15.0",
    "eslint": "^10.4.0",
    "rollup": "^3.30.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "d3": "^7.9.0",
    "docx": "^8.5.0",
    "express": "^4.19.2",
    "fast-json-patch": "^3.1.0",
    "handlebars": "^4.7.8",
    "jspdf": "^4.2.1",
    "papaparse": "^5.4.1",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.13.0",
    "plotly.js-dist-min": "^2.27.0",
    "qrcode": "^1.5.4",
    "svg2pdf.js": "^2.7.0",
    "three": "^0.185.1",
    "ws": "^8.16.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
